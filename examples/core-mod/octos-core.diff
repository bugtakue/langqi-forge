diff --git a/crates/octos-agent/src/agent/prompt_segments.rs b/crates/octos-agent/src/agent/prompt_segments.rs
index 2265a1d0..2f182e3c 100644
--- a/crates/octos-agent/src/agent/prompt_segments.rs
+++ b/crates/octos-agent/src/agent/prompt_segments.rs
@@ -130,6 +130,19 @@ impl PromptSegments {
                 }
             }
         }
+        // [arc-mod] ARC-Bench exam hook: extra rules injected by the adapter
+        // via env become a trailing system-prompt section. Absent/empty env
+        // renders byte-identically to the unpatched build.
+        if let Ok(extra) = std::env::var("OCTOS_ARC_EXTRA_RULES") {
+            let extra = extra.trim();
+            if !extra.is_empty() {
+                if !out.is_empty() {
+                    out.push_str("\n\n");
+                }
+                out.push_str("## ARC exam rules\n");
+                out.push_str(extra);
+            }
+        }
         out
     }
 }
